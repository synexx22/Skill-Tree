# Ключ DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_api_key_here
# Модель (по умолчанию deepseek-flash; для сложных объяснений можно deepseek-v4-pro)
DEEPSEEK_MODEL=deepseek-flash
# enabled — включить режим размышлений (медленнее и дороже). По умолчанию выключен.
# DEEPSEEK_THINKING=enabled
# Свой OpenAI-совместимый адрес (по умолчанию https://api.deepseek.com/chat/completions)
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# Дополнительные адреса, которым разрешено обращаться к /api (через запятую).
# Мобильные приложения Capacitor (capacitor://localhost, https://localhost) разрешены по умолчанию.
# ALLOWED_ORIGINS=https://example.com
