# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Модель (по умолчанию gemini-3.8-flash; можно gemini-3.7-flash или gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash
# Уровень размышлений для моделей Gemini 3: LOW (по умолчанию, быстрее), MEDIUM или HIGH.
# GEMINI_THINKING_LEVEL=LOW
# Свой адрес API (по умолчанию https://generativelanguage.googleapis.com/v1beta)
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Дополнительные адреса, которым разрешено обращаться к /api (через запятую).
# Мобильные приложения Capacitor (capacitor://localhost, https://localhost) разрешены по умолчанию.
# ALLOWED_ORIGINS=https://example.com
