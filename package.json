  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
